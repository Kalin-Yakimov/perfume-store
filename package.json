{
  "name": "perfume-store",
  "private": false,
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": "22.20.x"
  },
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "turbo lint",
    "test": "npm run test:unit",
    "test:unit": "node --test scripts/__tests__/*.test.cjs && npm run test:unit --workspace=@dtc/backend && npm run test:unit --workspace=@dtc/storefront",
    "test:integration:orders": "npm run test:integration:orders --workspace=@dtc/backend",
    "test:integration:catalog": "npm run test:integration:catalog --workspace=@dtc/backend",
    "test:integration:cache": "node scripts/test-cache-sync.cjs",
    "test:integration:operations": "npm run test:integration:operations --workspace=@dtc/backend",
    "test:e2e": "node scripts/run-e2e.cjs",
    "typecheck": "npm run typecheck --workspace=@dtc/backend && npm run typecheck --workspace=@dtc/storefront",
    "backend:seed": "turbo seed --filter=@dtc/backend",
    "backend:dev": "turbo dev --filter=@dtc/backend",
    "storefront:dev": "turbo dev --filter=@dtc/storefront"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.5",
      "@types/react-dom": "19.0.5"
    }
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.21.0",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "react": "19.0.5",
    "react-dom": "19.0.5",
    "turbo": "^2.0.14",
    "ajv": "^8.13.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "overrides": {
    "react": "19.0.5",
    "react-dom": "19.0.5",
    "lodash": "4.18.1",
    "postcss": "8.5.28",
    "eslint": {
      "ajv": "^6.12.4"
    },
    "@eslint/eslintrc": {
      "ajv": "^6.12.4"
    }
  }
}
